# Generate with: openssl rand -base64 32
MCP_AUTH_TOKEN=

# IMAP connection (required)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=mailbox@example.com
IMAP_PASS=
IMAP_TIMEOUT_MS=15000

# HTTP listener
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Send and draft capability (disabled by default)
ALLOW_SEND=false
SEND_RATE_PER_HOUR=5
SMTP_HOST=smtp.example.com
SMTP_SECURITY=implicit
# SMTP_PORT=465
# SMTP_USER=sender@example.com
# SMTP_PASS=
# MAIL_FROM=sender@example.com

# Move-to-trash capability (disabled by default)
ALLOW_TRASH=false
TRASH_RATE_PER_HOUR=20
